# Copy to .env.local and fill in. Never commit a filled-in file.

# Supabase. Use a project of Arena's own: do not point this at Upside Lab.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never commit a filled-in value and never expose it to a browser.
# The game engine writes cash, holdings and trades with this, because a player
# may read their portfolio but write none of it. Trading is disabled without it.
SUPABASE_SERVICE_ROLE_KEY=

# Public origin, used to build sign-in redirect links.
# Local development. In Vercel this is already set to https://upsidearena.com
# on All Environments, so pulling the project's variables down will override
# this with the production origin. See docs/DEPLOY.md.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sign in with Google. Server only: the secret must never reach a browser.
# Arena runs the handshake itself rather than handing it to Supabase, so that
# Google names the consent screen after upsidearena.com rather than after the
# Supabase project's hostname. The button appears when both of these are set
# and not otherwise, so there is no separate switch to forget.
# Redirect URI to register in Google: <site>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Shared secret for the settle endpoint. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it that endpoint refuses every request, which is the safe default.
CRON_SECRET=

# Signs the one-click unsubscribe link at the foot of every notification
# email. Optional: with it unset the service role key signs them instead,
# which works. Set it if you would rather the two were not the same string.
# With neither, an email carries no unsubscribe link at all, because a link
# anybody could forge would let a stranger turn off a stranger's mail.
UNSUBSCRIBE_SECRET=

# Product analytics needs no key. src/lib/analytics.ts sends events through
# @vercel/analytics, which Vercel configures for the project itself, so there
# is nothing to set here and nothing to copy into a deployment.
